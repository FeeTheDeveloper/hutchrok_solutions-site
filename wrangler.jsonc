{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hutchrok-solutions-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "www.hutchrok.com", "custom_domain": true },
    { "pattern": "hutchrok.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
