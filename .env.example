# ─── Hutchrok Solutions Group — Environment Variables ───
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it is already in .gitignore).
#
# These same variables must be set in Vercel:
#   Dashboard → Project → Settings → Environment Variables
# ────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────

# Supabase project URL (Settings → API in Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (Settings → API in Supabase dashboard)
SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key

# Optional explicit publishable key for @supabase/server.
# If omitted, the app falls back to SUPABASE_ANON_KEY.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional service role/secret key for future admin Supabase operations.
# Keep this server-side only and never expose it to the client.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional JWKS URL for JWT verification in @supabase/server auth flows.
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Shared secret that protects the /admin console and admin API routes.
# Generate one: openssl rand -base64 32
ADMIN_TOKEN=replace-with-a-strong-random-secret

# Clerk authentication (https://dashboard.clerk.com → API Keys)
# Required for /login, /sign-up, /dashboard, and the navbar Log In / Sign Up
# links. Without these, the site falls back to a helpful "auth not
# configured" message instead of erroring.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe (https://dashboard.stripe.com → Developers → API Keys).
# Required for the Stripe Checkout flow used by POST /api/stripe/checkout.
# Public key is safe for browser use; secret key and webhook secret are
# server-side only and must never be committed.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx

# Stripe webhook signing secret for POST /api/stripe/webhook
# (Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# ── OPTIONAL ──────────────────────────────────────────

# Ops integration token for inbound Power Automate / external webhooks.
# Required when /api/ops/* endpoints are used.
# Generate one: openssl rand -base64 32
# OPS_TOKEN=replace-with-a-strong-random-secret

# Outbound ops webhook URL (for case event notifications to Power Automate).
# Leave empty/commented to disable outbound ops events.
# OPS_WEBHOOK_URL=https://prod-xx.westus.logic.azure.com/...

# Resend API key — enables ALL outbound email (service requests, marketing
# lead notifications, and client filing-status notifications). When unset,
# email features self-disable silently.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# From identity for all outbound email. The domain MUST be verified in your
# Resend account (Resend → Domains) or delivery to clients will fail —
# `onboarding@resend.dev` only sends to your own Resend account email.
# Defaults to "Hutchrok Solutions Group <notifications@hutchrok.com>".
# RESEND_FROM_EMAIL=Hutchrok Solutions Group <notifications@hutchrok.com>

# Internal inbox that receives lead/service notifications and client replies.
# Defaults to contact@hutchrok.com.
# RESEND_TO_EMAIL=contact@hutchrok.com

# NOTE: Stripe keys were moved to the REQUIRED section above
# (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET). Per-service STRIPE_PRICE_*
# environment variables are DEPRECATED — Stripe Price IDs are now resolved
# server-side from the centralized catalog in lib/stripe-price-catalog.ts,
# not from environment variables. Update that file (not .env) to change
# which Stripe Price ID a service slug maps to.

# Public site URL used to build "Track My Filing" links in client
# status-change notifications. Defaults to https://hutchrok.com.
# NEXT_PUBLIC_SITE_URL=https://hutchrok.com

# Twilio credentials for client SMS status notifications (optional).
# All three must be set to enable the SMS channel; otherwise it self-disables.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+15125550123

# Browser-side Supabase URL/key (not currently used — all DB access via API routes)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key
